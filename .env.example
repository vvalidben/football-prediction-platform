# Copy to `.env` and replace every `change-me` value. `.env` is git-ignored.
# Read by Docker Compose and by the backend when run directly on the host.

# --- Application -------------------------------------------------------------
# One of: development, test, staging, production
ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API directly from a browser.
# Not needed when the frontend goes through the Vite or nginx proxy (the default).
CORS_ALLOWED_ORIGINS=
# Connect/read timeout for PostgreSQL and Redis connections (seconds).
DEPENDENCY_TIMEOUT_SECONDS=2
# Overall deadline for the /health dependency checks (seconds).
HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Rate limiting and caching (Sprint 16; see docs/operations.md) ------------
# Per-client limits, counted in Redis. If Redis is down the limiter is skipped
# rather than failing requests.
RATE_LIMIT_ENABLED=true
# Requests per window from one address, for everything except predictions.
RATE_LIMIT_REQUESTS=300
# Asking for a prediction builds features and runs a model, so it is stricter.
RATE_LIMIT_PREDICT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Brief caching of /data/status and /data/freshness only. 0 disables it.
CACHE_ENABLED=true
STATUS_CACHE_SECONDS=30

# --- PostgreSQL --------------------------------------------------------------
# Host/port used when the backend runs on the host. Compose overrides the host
# to `postgres` inside the Docker network.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football_predictions

# --- Redis -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me

# --- Football data providers -------------------------------------------------
# API-Football (https://www.api-football.com). Leave empty until you have a key;
# ingestion commands then fail fast with a clear message. This is the project's
# existing name for it — some API-Football examples call it API_FOOTBALL_KEY.
# Validate the provider with: python scripts/validate_api_football.py
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Client-side pacing: set to your plan's per-minute limit (Free 10, Pro 300).
API_FOOTBALL_REQUESTS_PER_MINUTE=10
# Per-request timeout and total attempts (first try + retries) for provider calls.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=4

# --- Host port mappings (Docker Compose) -------------------------------------
# Change these if the default ports are already in use on your machine.
# If you change POSTGRES_HOST_PORT or REDIS_HOST_PORT, update the matching
# POSTGRES_PORT / REDIS_PORT above for host-based backend runs.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Background jobs (Sprint 12; see docs/scheduled-jobs.md) ------------------
# Turn the whole scheduler off without changing code.
JOBS_ENABLED=true
# Provider competition ids the jobs keep up to date, comma separated (e.g. 39,140).
# Empty means the fetch jobs skip: they never invent data.
JOB_COMPETITIONS=
JOB_PROVIDER=api_football
# Every schedule is in minutes.
SCHEDULE_FIXTURES_MINUTES=360
SCHEDULE_RESULTS_MINUTES=60
SCHEDULE_STATISTICS_MINUTES=180
SCHEDULE_FEATURES_MINUTES=120
SCHEDULE_PREDICTIONS_MINUTES=180
SCHEDULE_EVALUATION_MINUTES=120
SCHEDULE_RETRAIN_MINUTES=1440
SCHEDULE_FAILURE_REPORT_MINUTES=1440
PREDICTION_HORIZON_DAYS=7
# Retraining runs only when both are satisfied (never after every match).
RETRAIN_ENABLED=true
RETRAIN_EVERY_DAYS=30
RETRAIN_MIN_NEW_MATCHES=100
# Retries: exponential backoff from this many seconds, capped.
TASK_MAX_RETRIES=5
TASK_RETRY_BACKOFF_SECONDS=10
TASK_RETRY_BACKOFF_MAX_SECONDS=900
# Celery broker/backend default to the Redis above (databases +1 and +2).
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
WORKER_CONCURRENCY=2
# Hard limit on a single job before the worker kills it.
TASK_TIME_LIMIT_SECONDS=1800
# How far back the statistics job re-checks matches, and the window the daily
# failure report covers.
STATISTICS_LOOKBACK_DAYS=7
FAILURE_REPORT_HOURS=24

# --- Database connection pool ------------------------------------------------
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# PostgreSQL cancels an API query that overruns this (seconds), so one slow
# statement cannot hold a connection until the pool is empty. The background jobs
# opt out: a backfill or a retrain runs long queries on purpose. 0 disables it.
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
